<idea-plugin>
    <id>org.openrndr.plugin.intellij</id>
    <name>OPENRNDR</name>
    <vendor url="https://openrndr.org/">OPENRNDR</vendor>
    <description><![CDATA[
        <p>Support for the <a href="https://openrndr.org">OPENRNDR</a> creative coding framework in IntelliJ IDEA.</p>

        <h2>Colors</h2>
        <ul>
          <li>Color swatches in the editor gutter for <code>ColorRGBa</code>, <code>rgb(…)</code>, <code>hsv(…)</code>,
              the other color models and the orx color spaces, with a color picker that edits the code</li>
          <li>Swatches in the completion list and in the debugger</li>
        </ul>

        <h2>Completion</h2>
        <ul>
          <li>Completion lists in sections, each with the first sentence of its KDoc: colors, <code>drawer.</code>,
              <code>program</code>, mouse and keyboard events, vectors, collections and strings, render targets,
              buffers, textures, shaders, shade and compute styles</li>
          <li>orx-compositor: sections in <code>compose { }</code> and <code>layer { }</code>, and every filter on the
              classpath in <code>post(…)</code> and <code>blend(…)</code>, by orx-fx package</li>
          <li>Members annotated with orx-parameters (<code>@DoubleParameter</code>, …) first, in any class</li>
          <li>Asset paths relative to the project root in <code>loadImage</code>, <code>loadFont</code> and the other loaders</li>
        </ul>

        <h2>Shaders</h2>
        <p>With <a href="https://plugins.jetbrains.com/plugin/6993-glsl-support">GLSL Support</a> installed, GLSL
        highlighting and completion in <code>fragmentTransform</code>, <code>vertexTransform</code>,
        <code>computeTransform</code> and the preambles.</p>

        <h2>Program structure</h2>
        <p>Checks for common mistakes in <code>application { program { extend { } } }</code>, with quick fixes.</p>

        <h2>OPENRNDR Mode</h2>
        <p><b>View | OPENRNDR Mode</b> (Ctrl+Alt+P) switches to a minimal layout and back: only the editor and the
        Run console, a play and stop button that run the current program, New and Duplicate Program, the OPENRNDR
        guide in an editor tab, New OPENRNDR Project (from openrndr-template) and a clean console.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends optional="true" config-file="openrndr-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="openrndr-jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Template behind New Program -->
        <internalFileTemplate name="OPENRNDR Program"/>

        <notificationGroup id="OPENRNDR Mode" displayType="BALLOON"/>

        <!-- Color swatches for OPENRNDR colors in the debugger; first, ahead of Kotlin's class renderer -->
        <debugger.compoundRendererProvider implementation="org.openrndr.plugin.intellij.OpenrndrDebuggerColors" order="first"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!-- The Kotlin integration only uses plain Kotlin PSI, which works in both Kotlin plugin modes -->
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <projectListeners>
        <listener class="org.openrndr.plugin.intellij.StopSketchAction$Refresher"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>

    <actions>
        <action id="Openrndr.Toggle"
                class="org.openrndr.plugin.intellij.OpenrndrModeAction"
                text="OPENRNDR Mode"
                description="Switch to a minimal layout for OPENRNDR programs (toggle to restore)">
            <add-to-group group-id="ViewMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt P"/>
        </action>

        <action id="Openrndr.RunSketch"
                class="org.openrndr.plugin.intellij.RunSketchAction"
                text="Run Sketch"
                description="Run the sketch in the current file"
                icon="AllIcons.Actions.Execute">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
        </action>

        <action id="Openrndr.StopSketch"
                class="org.openrndr.plugin.intellij.StopSketchAction"
                text="Stop"
                description="Stop everything that is running"
                icon="AllIcons.Actions.Suspend">
            <add-to-group group-id="MainToolbarRight" anchor="after" relative-to-action="Openrndr.RunSketch"/>
        </action>

        <group id="Openrndr.ProgramGroup"
                class="org.openrndr.plugin.intellij.OpenrndrProgramGroup"
                text="OPENRNDR">
            <separator/>
            <action id="Openrndr.NewProgram"
                    class="org.openrndr.plugin.intellij.NewOpenrndrProgramAction"
                    text="New Program..."
                    description="Create a new OPENRNDR program"/>
            <action id="Openrndr.DuplicateProgram"
                    class="org.openrndr.plugin.intellij.DuplicateOpenrndrProgramAction"
                    text="Duplicate Program..."
                    description="Copy the current OPENRNDR program into a new file"/>
            <separator/>
            <action id="Openrndr.OpenrndrGuide"
                    class="org.openrndr.plugin.intellij.OpenrndrGuideAction"
                    text="OPENRNDR Guide"
                    description="Open guide.openrndr.org in the built-in browser"/>
            <add-to-group group-id="MainToolbarRight" anchor="after" relative-to-action="Openrndr.StopSketch"/>
        </group>

        <group id="Openrndr.EditGroup"
                class="org.openrndr.plugin.intellij.SketchEditGroup"
                text="Sketch Editing"
                description="Reformat Code, Comment with Line Comment and Rename">
            <add-to-group group-id="MainToolbarRight" anchor="after" relative-to-action="Openrndr.StopSketch"/>
        </group>

        <group id="Openrndr.FolderGroup"
                class="org.openrndr.plugin.intellij.OpenrndrModeGroup"
                text="Project Folder">
            <separator/>
            <action id="Openrndr.ShowProjectFolder"
                    class="org.openrndr.plugin.intellij.ShowProjectFolderAction"
                    text="Show Project Folder"
                    description="Open the project root in the system file manager"/>
            <add-to-group group-id="MainToolbarRight" anchor="after" relative-to-action="Openrndr.EditGroup"/>
        </group>

        <action id="Openrndr.NewOpenrndrProject"
                class="org.openrndr.plugin.intellij.NewOpenrndrProjectAction"
                text="New OPENRNDR Project..."
                description="Clone the OPENRNDR template into a new folder and open it">
            <add-to-group group-id="NewProjectOrModuleGroup" anchor="first"/>
        </action>

    </actions>
</idea-plugin>
